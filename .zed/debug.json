// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug native binary",
    "build": {
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-I",
        "$ZED_DIRNAME/thirdparties/include",
        "-g",
        "device.cpp",
        "image.cpp",
        "swapchain.cpp",
        "pipeline.cpp",
        "camera.cpp",
        "buffer.cpp",
        "commandbuffer.cpp",
        "texture.cpp",
        "$ZED_FILENAME",
        "-o",
        "$ZED_DIRNAME/build/current1",
        "-lglfw",
        "-lvulkan",
        "-ldl",
        "-lpthread",
        "-lX11",
        "-lXxf86vm",
        "-lXrandr",
        "-lXi",
      ],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "program": "$ZED_WORKTREE_ROOT/build/current1",
    "request": "launch",
    "adapter": "CodeLLDB",
  },
]
